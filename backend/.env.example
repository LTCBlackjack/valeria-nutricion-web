# ============================================================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN (Valeria de la Torre - Nutrición)
# ============================================================================

# Puerto del servidor
PORT=3000

# Correo de la Nutrióloga (donde recibirá las alertas de nuevas reservas pagadas)
NUTRITIONIST_EMAIL=valeria.delatorre.nutricion@gmail.com

# Configuración de Google Calendar API
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=./google-service-account.json

# Configuración de Correo Saliente (SMTP / Gmail App Password / Resend / Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=reservas.valerianutricion@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_aqui

# Claves de Pasarela de Pago (Stripe o Mercado Pago)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
